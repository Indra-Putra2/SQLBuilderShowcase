@page "/playground"
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="container">
	<h1 class="fw-bold">Parser Playground</h1>
	<p class="text-muted mb-4">
		Paste your input below to watch your get turn into SQL query on the fly.
	</p>

	<!-- Schema Reference -->
	<div class="card mb-4 border-info shadow-sm">
		<div class="card-header bg-info bg-opacity-10 d-flex justify-content-between align-items-center">
			<button type="button"
			class="card-header bg-info bg-opacity-10 border-0 w-100 text-start"
			@onclick="() => Toggle(ref _schemaCollapsed)">
				<div class="d-flex justify-content-between align-items-center">
					<h5 class="mb-0 text-info-emphasis fw-bold">
						<i class="bi bi-check2-circle me-2"></i>
						Valid Columns Schema Reference
					</h5>

					<i class="bi @(_schemaCollapsed ? "bi-chevron-down" : "bi-chevron-up")"></i>
				</div>
			</button>
		</div>
		@if (!_schemaCollapsed)
		{
			<div id="schemaReference" class="collapse show">
				<div class="card-body">
					<div class="row g-3 p-2">
						<!-- RAM -->
						<div class="@(_includeJoin ? "col-md-6" : "col-md-12")">
							<div class="card h-100 border-0 shadow-sm schema-card">
								<div class="card-header bg-primary bg-opacity-10 border-0 d-flex align-items-center justify-content-between">
									<div class="d-flex align-items-center">
										<i class="bi bi-memory text-primary fs-5 me-2"></i>
										<div>
											<div class="fw-bold text-primary">RAM Columns</div>
											<small class="text-muted">Rams</small>
										</div>
									</div>

									<span class="badge bg-primary rounded-pill">
										@_ramColumns.Count
									</span>
								</div>

								<div class="card-body">
									<div class="d-flex flex-wrap gap-2">
										@foreach (var column in _ramColumns)
										{
											<button class="btn btn-sm btn-outline-primary column-pill">
												<i class="bi bi-columns-gap me-1"></i>
												@column
											</button>
										}
									</div>
								</div>
							</div>
						</div>

						<!-- Brand -->
						@if (_includeJoin)
						{
							<div class="col-md-6">
								<div class="card h-100 border-0 shadow-sm schema-card">
									<div class="card-header bg-success bg-opacity-10 border-0 d-flex align-items-center justify-content-between">
										<div class="d-flex align-items-center">
											<i class="bi bi-tags text-success fs-5 me-2"></i>
											<div>
												<div class="fw-bold text-success">Brand Columns</div>
												<small class="text-muted">Brands</small>
											</div>
										</div>

										<span class="badge bg-success rounded-pill">
											@_brandColumns.Count
										</span>
									</div>

									<div class="card-body">
										<div class="d-flex flex-wrap gap-2">
											@foreach (var column in _brandColumns)
											{
												<button class="btn btn-sm btn-outline-success column-pill">
													<i class="bi bi-columns-gap me-1"></i>
													@column
												</button>
											}
										</div>
									</div>
								</div>
							</div>
						}

						<!-- DTO -->
						<div class="col-12">
							<div class="card border-0 shadow-sm schema-card">
								<div class="card-header bg-warning bg-opacity-10 border-0 d-flex align-items-center justify-content-between">
									<div class="d-flex align-items-center">
										<i class="bi bi-box text-warning-emphasis fs-5 me-2"></i>
										<div>
											<div class="fw-bold text-warning-emphasis">Target DTO</div>
											<small class="text-muted">Output mapping</small>
										</div>
									</div>

									<span class="badge bg-warning text-dark rounded-pill">
										@_DTOColumns.Count
									</span>
								</div>

								<div class="card-body">
									<div class="d-flex flex-wrap gap-2">
										@foreach (var column in _DTOColumns)
										{
											<button class="btn btn-sm btn-outline-secondary column-pill">
												<i class="bi bi-braces me-1"></i>
												@column
											</button>
										}
									</div>
								</div>
							</div>
						</div>

					</div>
				</div>
			</div>
		}

	</div>
	<!-- Custom Syntax Guide -->
	<div class="card mb-4 border-info shadow-sm">
		<div class="card-header bg-info bg-opacity-10 d-flex justify-content-between align-items-center">
			<button type="button"
			class="card-header bg-info bg-opacity-10 border-0 w-100 text-start"
			@onclick="() => Toggle(ref _SyntaxGuideCollapse)">

				<div class="d-flex justify-content-between align-items-center">
					<h5 class="mb-0 text-info-emphasis fw-bold">
						<i class="bi bi-book me-2"></i>
						Syntax Reference Guide
					</h5>

					<i class="bi @(_SyntaxGuideCollapse ? "bi-chevron-down" : "bi-chevron-up")"></i>
				</div>
			</button>
		</div>

		@if (!_SyntaxGuideCollapse)
		{
			<div class="collapse show" id="syntaxGuideCollapse">
				<div class="card-body">
					<div class="row g-3 p-2">
						<!-- Identifiers & Functions -->
						<div class="col-md-6">
							<h6 class="fw-bold text-uppercase text-secondary fs-7">Clauses</h6>
							<ul class="list-unstyled mb-0 font-monospace fs-7">
								<li class="mb-2 d-flex align-items-center">
									<span class="badge bg-secondary me-2" style="min-width: 75px;">Select</span>
									<code>r.Price</code>, <code>b.name</code>, <code>r.*</code>
								</li>
								<li class="mb-2 d-flex align-items-center">
									<span class="badge bg-secondary me-2" style="min-width: 75px;">Joins</span>
									<code>r.brandid = b.id</code>, <code>r.brandid = b.id AND r.price &gt; 0</code>
								</li>
								<li class="mb-2 d-flex align-items-center">
									<span class="badge bg-secondary me-2" style="min-width: 75px;">Where</span>
									<code>r.Price &lt; 100</code>, <code>r.Price &lt; 100 AND b.name LIKE '%Corsair%'</code>
								</li>
								<li class="mb-2 d-flex align-items-center">
									<span class="badge bg-secondary me-2" style="min-width: 75px;">GroupBy</span>
									<code>r.Price</code>
								</li>
								<li class="mb-2 d-flex align-items-center">
									<span class="badge bg-secondary me-2" style="min-width: 75px;">Having</span>
									<code>AVG(r.Price) TYPE Decimal &gt; 0</code>
								</li>
								<li class="mb-2 d-flex align-items-center">
									<span class="badge bg-secondary me-2" style="min-width: 75px;">OrderBy</span>
									<code>r.PricePerGB</code>
								</li>
							</ul>
						</div>

						<!-- Operators & Literals -->
						<div class="col-md-6">
							<h6 class="fw-bold text-uppercase text-secondary fs-7">Custom Syntax</h6>
							<ul class="list-unstyled mb-0 font-monospace fs-7">
								<li class="mb-2 d-flex align-items-center">
									<span class="badge bg-secondary me-2" style="min-width: 75px;">Functions</span>
									<code>AVG(r.price) TYPE DECIMAL</code>, <code>AVG(r.price) CONST INT?</code>
								</li>
								<li class="mb-2 d-flex align-items-center">
									<span class="badge bg-secondary me-2" style="min-width: 75px;">Date</span>
									<code>d'2020-05-01'</code>, <code>D'2025-02-01'</code>
								</li>
								<li class="mb-2 d-flex align-items-center">
									<span class="badge bg-secondary me-2" style="min-width: 75px;">Time</span>
									<code>t'20:35:14'</code>, <code>T'18:25:00'</code>
								</li>
								<li class="mb-2 d-flex align-items-center">
									<span class="badge bg-secondary me-2" style="min-width: 75px;">DateTime</span>
									<code>dt'2020-05-01 20:35:14'</code>, <code>DT'2025-02-01 18:25:00'</code>
								</li>
							</ul>
						</div>

						<div class="col-12 border-top pt-3">
							<h6 class="fw-bold text-uppercase text-secondary fs-7">
								Custom Syntax Explanation
							</h6>

							<ul class="list-unstyled mb-0 font-monospace fs-7">
								<li class="mb-2 d-flex align-items-center">
									<span class="badge bg-secondary me-2" style="min-width: 75px;">TYPE</span>
									Defines the return type of a function.
								</li>
								<li class="mb-2 d-flex align-items-center">
									<span class="badge bg-secondary me-2" style="min-width: 75px;">Types</span>
									<code>INT</code>, <code>DECIMAL</code>, <code>DOUBLE</code>,
									<code>STRING</code>, <code>GUID</code>, <code>BOOL</code>,
									<code>DATE</code>, <code>TIME</code>, <code>DATETIME</code>,
									<code>BINARY</code>, <code>NULL</code>
								</li>
								<li class="mb-2 d-flex align-items-center">
									<span class="badge bg-secondary me-2" style="min-width: 75px;">?</span>
									Marks a type as nullable, e.g. <code>INT?</code>
								</li>
								<li class="mb-2 d-flex align-items-center">
									<span class="badge bg-secondary me-2" style="min-width: 75px;">Function</span>
									Function syntax: [Name]([Arguments]) [TYPE] [CONST] [Return TYPE][?] —
									&nbsp;<code>TYPE</code>,&nbsp;<code>CONST</code>&nbsp;and&nbsp;<code>?</code>&nbsp;are optional.
								</li>
							</ul>
						</div>

						<!-- Full Example -->
						<div class="col-12 border-top pt-3">
							<span class="fw-bold d-block mb-1 text-muted fs-7 text-uppercase">Example Expressions:</span>
							<div class="d-flex flex-wrap gap-2">
								<span class="badge bg-dark font-monospace">r.Price &lt; 100 AND b.name LIKE '%Corsair%'</span>
								<span class="badge bg-dark font-monospace">AVG(r.ReviewCount) Type Decimal? &gt; 100</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		}

	</div>
	<!-- Main Playground -->
	<div id="main-playground" class="card mb-4 border-info shadow-sm">
		<div class="card-header bg-info bg-opacity-10 d-flex justify-content-between align-items-center">
			<button type="button"
			class="card-header bg-info bg-opacity-10 border-0 w-100 text-start"
			@onclick="() => Toggle(ref _sqlBuilderCollapse)">

				<div class="d-flex justify-content-between align-items-center">
					<h5 class="mb-0 text-info-emphasis fw-bold">
						<i class="bi bi-database-fill-gear me-2"></i>
						SQL Builder
					</h5>

					<i class="bi @(_sqlBuilderCollapse ? "bi-chevron-down" : "bi-chevron-up")"></i>
				</div>
			</button>
		</div>
		@if (!_sqlBuilderCollapse)
		{
			<div class="card-body">
				<!-- Base SQL -->
				<div class="row g-3 p-2">
					<div class="col-6">
						<h4 class="fw-bold text-primary text-uppercase bi bi-archive"
							style="letter-spacing: 1px;">
							Build Base SQL
						</h4>
					</div>
					<div class="d-flex col-6 justify-content-end align-items-center gap-3">
						<h5 class="fw-bold text-muted mb-0">Presets:</h5>

						<div class="btn-group" role="group">
							<input type="radio" class="btn-check" name="btnradio" id="btnradio1" autocomplete="off" checked>
							<label class="btn btn-outline-primary" for="btnradio1" @onclick="() => LoadQuery(1)">
								Simple Query
							</label>

							<input type="radio" class="btn-check" name="btnradio" id="btnradio2" autocomplete="off">
							<label class="btn btn-outline-primary" for="btnradio2" @onclick="() => LoadQuery(2)">
								Complex Query
							</label>
						</div>
					</div>
					
					<hr />
					<!--Root-->
					<div class="col-md-2">
						<label for="rootAlias" class="form-label fw-bold">
							Root Table Alias:
						</label>

						<input id="rootAlias"
						type="text"
						class="form-control @(_rootAlias?.Trim() == "" ? "is-invalid" : "")"
						placeholder="e.g., r"
						@bind="_rootAlias" />

						@if (string.IsNullOrWhiteSpace(_rootAlias))
						{
							<div class="invalid-feedback">
								Root alias is required.
							</div>
						}
					</div>

					<!--Join-->
					@if (_includeJoin)
					{
						<div class="col-md-2">
							<label for="joinAlias" class="form-label fw-bold">
								Join Table Alias:
							</label>

							<input id="joinAlias"
								   type="text"
								   class="form-control @(string.IsNullOrWhiteSpace(_joinAlias) ? "is-invalid" : "")"
								   placeholder="e.g., b"
								   @bind="_joinAlias" />

							@if (string.IsNullOrWhiteSpace(_joinAlias))
							{
								<div class="invalid-feedback">
									Join Table Alias is required.
								</div>
							}
						</div>
						<div class="col-md-6">
							<label for="onCondition" class="form-label fw-bold">
								Join ON Condition:
							</label>

							<input id="onCondition"
								   type="text"
								   class="form-control @(string.IsNullOrWhiteSpace(_joinCondition) ? "is-invalid" : "")"
								   placeholder="e.g., r.brandId = b.id"
								   @bind="_joinCondition" />

							@if (string.IsNullOrWhiteSpace(_joinCondition))
							{
								<div class="invalid-feedback">
									Join ON Condition is required.
								</div>
							}
						</div>
						<div class="col-md-2">
							<label for="sqlFilterType" class="form-label fw-bold">Select Filter Type:</label>
							<select id="sqlFilterType" class="form-select" @bind="_joinType">
								@foreach (var type in Enum.GetValues<SQLJoinType>())
								{
									<option value="@type">@type</option>
								}
							</select>
						</div>
					}
				</div>

				<div class="row g-3 p-2">
					<div class="col-md-12">
						<label for="selectSQL" class="form-label fw-bold">
							Select Scope:
						</label>

						<textarea id="selectSQL"
						class="form-control @(string.IsNullOrWhiteSpace(_select) ? "is-invalid" : "")"
						placeholder="e.g., r.*, b.name"
						@bind="_select"></textarea>

						@if (string.IsNullOrWhiteSpace(_select))
						{
							<div class="invalid-feedback">
								Select Scope is required.
							</div>
						}
					</div>
				</div>

				<div class="row g-3 p-2">
					<div class="col-md-12 d-flex align-content-center gap-3">
						<button class="btn btn-primary fw-bold "
						disabled="@IsBaseQueryInvalid"
						@onclick="BuildBaseQuery">
							Compile Base Structure
						</button>
						<div class="btn-group" role="group" aria-label="Basic checkbox toggle button group">
							<input type="checkbox" class="btn-check" id="btncheck1" autocomplete="off" checked @onclick="HandleJoin">
							<label class="btn btn-outline-primary" for="btncheck1">With Join</label>
						</div>
					</div>
					<div class="col-md-12">
						<pre class="p-3 bg-dark rounded border mb-0 font-monospace @(_baseQueryError ? "text-danger border-danger" : "text-info")"
							 style="min-height: 60px; font-size: 0.9rem;">@_baseQuery</pre>
					</div>
				</div>

				<hr class="my-4" />

				<!-- SQL Filter -->
				<div class="row g-3 p-2">
					<div class="col-md-12">
						<h4 class="mb-3 fw-bold text-success text-uppercase bi bi-funnel"
						style="letter-spacing: 1px;">
							SQL Filter
						</h4>

						<label for="WhereExpression" class="form-label fw-bold">
							Where Expression:
						</label>

						<textarea id="WhereExpression"
						class="form-control font-monospace"
						rows="2"
						placeholder="e.g., r.Price < 100"
						@bind="_where"></textarea>
					</div>
				</div>
				<div class="row g-3 p-2">
					<div class="col-md-12">
						<label for="WhereExpression" class="form-label fw-bold">
							GroupBy Expression:
						</label>

						<textarea id="WhereExpression"
						class="form-control font-monospace"
						rows="2"
						placeholder="e.g., r.Price"
						@bind="_groupby"></textarea>
					</div>
				</div>

				<div class="row g-3 p-2">
					<div class="col-md-12">
						<label for="HavingExpression" class="form-label fw-bold">
							Having Expression:
						</label>
						<!-- Changed @having inside content to @bind="having" -->
						<textarea id="HavingExpression"
						class="form-control font-monospace"
						rows="2"
						placeholder="e.g., AVG(r.ReviewCount) > 100"
						@bind="_having"></textarea>
					</div>
				</div>

				<div class="row g-3 p-2">
					<div class="col-md-12">
						<label for="OrderByExpression" class="form-label fw-bold">
							OrderBy Expression:
						</label>
						<!-- Changed @orderby inside content to @bind="orderby" -->
						<textarea id="OrderByExpression"
						class="form-control font-monospace"
						rows="2"
						placeholder="r.PricePerGB DESC"
						@bind="_orderby"></textarea>
					</div>
				</div>

				<div class="row p-2">
					<div class="col-md-auto">
						<button class="btn btn-success fw-bold shadow-sm" @onclick="BuildSQL">
							Generate Target SQL
						</button>
					</div>

					<label for="Limit" class="col-auto align-content-center">
						LIMIT:
					</label>

					<div class="col-md-1">
						<input id="Limit"
						type="text"
						class="form-control"
						placeholder="50"
						@bind="_limit" />
					</div>
				</div>
				<div class="row g-3 p-2">
					<div class="col-md-12">
						<label for="SQL" class="form-label fw-bold mt-1">SQL Result</label>
						<pre id="SQL" class="p-3 bg-dark rounded border mb-0 font-monospace @(_completeQueryError ? "text-danger border-danger" : "text-info")"
						style="min-height: 120px; font-size: 0.95rem; line-height: 1.4;">@_completeSQLQuery</pre>

						<label for="DynamicParameters" class="form-label fw-bold mt-1">Dynamic Parameters</label>
						<pre id="DynamicParameters" class="p-3 bg-dark text-info rounded border mb-0 font-monospace"
						style="min-height: 120px; font-size: 0.95rem; line-height: 1.4;">
							@_dynamicParameters
						</pre>
					</div>
				</div>
			</div>
		}

	</div>
	<!-- Limitations & Edge Cases -->
	<div id="limitations" class="card mb-4 border-warning shadow-sm">
		<div class="card-header bg-warning bg-opacity-10 d-flex justify-content-between align-items-center">
			<button type="button"
			class="card-header bg-info bg-opacity-10 border-0 w-100 text-start"
			@onclick="() => Toggle(ref _limitationCollapse)">

				<div class="d-flex justify-content-between align-items-center">
					<h5 class="mb-0 text-warning-emphasis fw-bold">
						<i class="bi bi-exclamation-triangle me-2"></i>
						Parser Limitations
					</h5>

					<i class="bi @(_limitationCollapse ? "bi-chevron-down" : "bi-chevron-up")"></i>
				</div>
			</button>
		</div>
		@if (!_limitationCollapse)
		{
			<div class="collapse show" id="limitationsCollapse">
				<div class="card-body">
					<div class="row g-4 p-2">
						<!-- Clause Support & Grammar Rules -->
						<div class="col-md-6 border-end">
							<h6 class="fw-bold text-uppercase text-secondary fs-7 mb-3">
								<i class="bi bi-diagram-3 me-1"></i> Grammar & Syntax Constraints
							</h6>
							<ul class="list-unstyled mb-0 font-monospace fs-7">
								<li class="mb-3 d-flex align-items-start">
									<span class="badge bg-danger me-2 mt-1" style="min-width: 85px;">Subqueries</span>
									<div>
										Subqueries inside <code>WHERE</code> or <code>FROM</code> (e.g., <code>IN (SELECT ...)</code>) are not supported.
									</div>
								</li>
								<li class="mb-3 d-flex align-items-start">
									<span class="badge bg-danger me-2 mt-1" style="min-width: 85px;">Aggregates</span>
									<div>
										Aggregate functions are not validated for clause-specific SQL restrictions.
										The query builder treats functions as generic expressions and leaves
										database-specific validation to the target database.
									</div>
								</li>
								<li class="mb-0 d-flex align-items-start">
									<span class="badge bg-danger me-2 mt-1" style="min-width: 85px;">Aliases</span>
									<div>
										Column aliases defined in <code>SELECT</code> cannot be referenced inside <code>WHERE</code> or <code>GROUP BY</code>.
									</div>
								</li>
								<li class="mb-0 d-flex align-items-start">
									<span class="badge bg-danger me-2 mt-1" style="min-width: 85px;">Row/tuple</span>
									<div>
										<strong>Row/tuple expressions are not currently supported.</strong> Parenthesized expressions must contain a single expression; constructs such as <code>(a, b)</code> are not yet implemented.
									</div>
								</li>
							</ul>
						</div>

						<!-- Type Hints & Escaping -->
						<div class="col-md-6">
							<h6 class="fw-bold text-uppercase text-secondary fs-7 mb-3">
								<i class="bi bi-code-square me-1"></i> Types & Literal Formatting
							</h6>
							<ul class="list-unstyled mb-0 font-monospace fs-7">
								<li class="mb-3 d-flex align-items-start">
									<span class="badge bg-danger me-2 mt-1" style="min-width: 85px;">Dates</span>
									<div>
										Must strictly follow ISO format with prefixes: <code>d'YYYY-MM-DD'</code> or <code>t'HH:mm:ss'</code> or <code>dt'YYYY-MM-DD HH:mm:ss'</code>.
									</div>
								</li>
								<li class="mb-3 d-flex align-items-start">
									<span class="badge bg-danger me-2 mt-1" style="min-width: 85px;">Functions</span>
									<div>
										Functions are parsed by their structure rather than their database-specific semantics.
										Return types require an explicit <code>TYPE</code> hint.
									</div>
								</li>
								<li class="mb-3 d-flex align-items-start">
									<span class="badge bg-danger me-2 mt-1" style="min-width: 85px;">TYPE Hint</span>
									<div>
										Aggregate return types require explicit hints (e.g., <code>TYPE DECIMAL</code>, <code>CONST DECIMAL?</code>).
									</div>
								</li>
								<li class="mb-3 d-flex align-items-start">
									<span class="badge bg-danger me-2 mt-1" style="min-width: 85px;">Quotes</span>
									<div>
										String values must use single quotes (<code>'text'</code>). Double quotes (<code>"text"</code>) are reserved for identifiers.
									</div>
								</li>
								<li class="mb-0 d-flex align-items-start">
									<span class="badge bg-danger me-2 mt-1" style="min-width: 85px;">Identifiers</span>
									<div>
										Qualified column names require table aliases (e.g., <code>r.Price</code> instead of bare <code>Price</code>).
									</div>
								</li>
								<li class="mb-3 d-flex align-items-start">
									<span class="badge bg-danger me-2 mt-1" style="min-width: 85px;">Parameters</span>
									<div>
										Literal values in supported expressions are automatically parameterized
										when generating SQL. Values are supplied separately through Dapper parameters.
									</div>
								</li>
							</ul>
						</div>

						<!-- Footer Summary Note -->
						<div class="col-12 border-top pt-3">
							<div class="alert alert-light border mb-0 d-flex align-items-center fs-7 text-muted">
								<i class="bi bi-info-circle-fill text-primary me-2 fs-5"></i>
								<span>
									<strong>Note:</strong> Syntax errors encountered during parsing will fail fast before the AST compilation pass.
								</span>
							</div>
						</div>
					</div>
				</div>
			</div>
		}
	</div>
</div>

@code {
	private string _rootAlias = "r";
	private string _joinAlias = "b";
	private string _joinCondition = "r.brandid = b.id";
	private string _select = "r.*";
	private string _having = "AVG(r.ReviewCount) TYPE DECIMAL > 100";
	private string _where = "r.Price < 100";
	private string _groupby = "r.name";
	private string _orderby = "r.PricePerGB DESC";
	private string _baseQuery = "Compile Base Structure to see result!";
	private string _completeSQLQuery = "Click Generate Target SQL to see result!";
	private string _dynamicParameters = "Click Generate Target SQL to see result!";

	private bool _schemaCollapsed = true;
	private bool _SyntaxGuideCollapse = true;
	private bool _limitationCollapse = true;
	private bool _sqlBuilderCollapse = false;
	private bool _baseQueryError = false;
	private bool _completeQueryError = false;
	private bool _includeJoin = false;

	private int? _limit = 10;

	private List<string> _ramColumns = new();
	private List<string> _brandColumns = new();
	private List<string> _DTOColumns = new();
	private IQueryFilter _query = null!;
	private SQLJoinType _joinType;

	protected override void OnInitialized()
	{
		var ramProps = typeof(RamBaseModel).GetProperties();
		var brandProps = typeof(BrandBaseModel).GetProperties();
		var dtoProps = typeof(RamReadModel).GetProperties();

		_ramColumns = ramProps.Select(r => r.Name).ToList();
		_brandColumns = brandProps.Select(b => b.Name).ToList();
		_DTOColumns = dtoProps.Select(d => d.Name).ToList();
		HandleJoin();
		LoadQuery(1);

		if (Navigation.Uri.EndsWith("#limitations", StringComparison.OrdinalIgnoreCase))
		{
			_limitationCollapse = false;
		}
	}

	private void BuildBaseQuery()
	{
		try
		{
			if (_includeJoin)
			{
				_query = QueryBuilder
					.Create<RamReadModel>()
					.From<RamBaseModel>(_rootAlias)
					.Select(_select)
					.Join<BrandBaseModel>(_joinAlias, _joinCondition, _joinType)
					.ValidateBaseQuery();
			}
			else
			{
				_query = QueryBuilder
					.Create<RamReadModel>()
					.From<RamBaseModel>(_rootAlias)
					.Select(_select)
					.ValidateBaseQuery();
			}

			_baseQueryError = false;
			_baseQuery = _query.Build().SQL;
		}
		catch(Exception e)
		{
			_baseQueryError = true;
			_baseQuery = e.Message;
		}
	}

	private void BuildSQL()
	{
		if (_query == null)
		{
			_completeSQLQuery = "Build Base Query First!";
			_dynamicParameters = "Build Base Query First!";
			return;
		}

		try
		{
			var result = _query
			.Having(_having)
			.Where(_where)
			.GroupBy(_groupby)
			.OrderBy(_orderby)
			.Limit(_limit)
			.Build();

			_completeQueryError = false;
			_completeSQLQuery = result.SQL;

			_dynamicParameters = "";
			foreach(var name in result.Parameters.ParameterNames)
			{
				_dynamicParameters += $"{name} = {result.Parameters.Get<object>(name)}\n";
			}
		}
		catch(Exception e)
		{
			_completeQueryError = true;
			_completeSQLQuery = e.Message;
			_dynamicParameters = string.Empty;
		}
	}

	private void Toggle(ref bool collapse)
	{
		collapse = !collapse;
	}

	private void LoadQuery(int type)
	{
		switch (type)
		{
			case 2: // Complex
				_rootAlias = "r";
				_select = "r.*";
				_having = "AVG(r.ReviewCount) TYPE DECIMAL > 100";
				_where = "r.Price < 100";
				_groupby = "r.name";
				_orderby = "r.PricePerGB DESC";
				break;

			case 1: // Simple
			default:
				_rootAlias = "r";
				_select = "r.*";
				_having = "";
				_where = "r.Price < 100";
				_groupby = "";
				_orderby = "r.PricePerGB DESC";
				break;
		}

		if (_includeJoin) _select += ", b.name as brandname";
		_baseQuery = "Compile Base Structure to see result!";
		_completeSQLQuery = "Build Base Query First!";
		_dynamicParameters = "Build Base Query First!";
		_query = null;
	}
	private void HandleJoin()
	{
		Toggle(ref _includeJoin);

		_select = "r.*";

		if (_includeJoin)
			_select += ", b.name as brandname";
	}

	private bool IsBaseQueryInvalid =>
		string.IsNullOrWhiteSpace(_rootAlias) ||
		string.IsNullOrWhiteSpace(_select) ||
		(_includeJoin &&
			(string.IsNullOrWhiteSpace(_joinAlias) ||
			 string.IsNullOrWhiteSpace(_joinCondition)));
}