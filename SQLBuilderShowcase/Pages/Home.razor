				<small class="text-muted fs-7">Runtime</small>
			</div>
		</div>

		<!-- Blazor -->
		<div class="col-6 col-sm-4 col-md-3 col-lg-2">
			<div class="card bg-body-tertiary border-0 h-100 text-center p-3 transition-hover shadow-sm">
				<i class="bi bi-fire fs-2 text-danger mb-2"></i>
				<div class="fw-bold fs-6">Blazor WASM</div>
				<small class="text-muted fs-7">UI Engine</small>
			</div>
		</div>

		<!-- Dapper -->
		<div class="col-6 col-sm-4 col-md-3 col-lg-2">
			<div class="card bg-body-tertiary border-0 h-100 text-center p-3 transition-hover shadow-sm">
				<i class="bi bi-lightning-charge-fill fs-2 text-warning mb-2"></i>
				<div class="fw-bold fs-6">Dapper</div>
				<small class="text-muted fs-7">Micro-ORM</small>
			</div>
