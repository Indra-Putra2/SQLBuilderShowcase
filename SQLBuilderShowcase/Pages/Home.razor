@page "/"
@inject IJSRuntime JS

<PageTitle>Home</PageTitle>
<!--Main-->
<div class="container-fluid px-3 px-md-4">
	<!-- Hero -->
	<div class="py-4 text-center mb-1"> 
		<i class="d-flex justify-content-center align-content-center mx-auto mb-4 bi bi-database-fill-check" style="width:100px; height:100px; font-size:100px"></i>
		<h1 class="display-4 fw-bold text-body-emphasis">SQL QUERY BUILDER</h1> 
		<div class="col-lg-6 mx-auto"> 
			<p class="lead mb-4 fs-4 text-muted">Build SQL queries dynamically, safely, and with less boilerplate.</p>
			<div class="d-grid gap-2 d-sm-flex justify-content-sm-center mb-4"> 
				<a href="/playground#main-playground" class="btn btn-primary btn-lg px-4 gap-3">Try the Playground</a>
				<a href="/api" class="btn btn-outline-secondary text-muted btn-lg px-4">Read Documentation</a>
			</div>
		</div>
	</div>
	<!-- Why -->
	<div class="d-flex flex-wrap justify-content-center text-center mx-auto gap-3 mb-4">
		<h1 class="w-100 display-6 fw-bold text-body-emphasis">WHY SQL QUERY BUILDER?</h1>

		<div class="card p-3 bg-info-subtle" style="width: 220px; height:170px">
			<h5 class="card-header-pills fw-bold my-3 bi bi-gear-fill" style="color:#2ECC71"> DYNAMIC</h5>
			<p class="card-body text-muted">Build queries from runtime input</p>
		</div>
		<div class="card p-3 bg-info-subtle" style="width: 220px; height:170px">
			<h5 class="card-header-pills fw-bold my-3 bi bi-lightbulb-fill" style="color:#2ECC71"> TYPE-AWARE</h5>
			<p class="card-body text-muted">Analyze expression types through AST</p>
		</div>
		<div class="card p-3 bg-info-subtle" style="width: 220px; height:170px">
			<h5 class="card-header-pills fw-bold my-3 bi bi-shield-fill" style="color:#2ECC71"> VALIDATED</h5>
			<p class="card-body text-muted">Validate input before SQL output</p>
		</div>
	</div>
	<!-- Links -->
	<div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
		<a href="YOUR_GITHUB_URL" class="btn btn-dark d-flex align-items-center gap-2 px-4"> 
			<i class="bi bi-github fs-5"></i> GitHub 
		</a> 
		<a href="YOUR_LINKEDIN_URL" class="btn btn-primary d-flex align-items-center gap-2 px-4"> 
			<i class="bi bi-linkedin fs-5"></i> LinkedIn 
		</a>
	</div>
</div>
<!--Main-->
<hr class="my-5"/>
<!--Details-->
<!--FROM C# TO SQL-->
<div class="container-fluid mb-5">
	<div class="row">
		<div class="col-12 display-6 fw-bold text-center mb-1">
			FROM C# TO SQL
		</div>
		<div class="col-12 text-muted text-center mb-4">
			Build dynamic, parameterized SQL queries with a fluent C# API.
		</div>

		<div class="col-6 fw-semibold fs-3 bi bi-stack mb-3 text-center">
			 Builder
		</div>
		<div class="col-6 fw-semibold fs-3 bi bi-box2-fill mb-3 text-center">
			 Results
		</div>

		<div class="col-6">
			<div class="card text-start bg-dark text-light font-monospace">
				<h5 class="card-header text-muted">C# Builder</h5>
				<div class="card-body p-4">
					<div><code>var query = builder</code></div>
					<div class="ms-4"><code>.From&lt;RamReadModel&gt;("r")</code></div>
					<div class="ms-4"><code>.Select("r.Name", "r.Price")</code></div>
					<div class="ms-4"><code>.Where("r.Price &gt; 10")</code></div>
					<div class="ms-4"><code>.OrderBy("r.Price DESC")</code></div>
					<div class="ms-4"><code>.Limit(10)</code></div>
					<div class="ms-4"><code>.Build();</code></div>
				</div>
			</div>
		</div>
		<div class="col-6">
			<div class="row">
				<div class="col-12 border border-success-subtle rounded-3 bg-dark p-3 mb-2">
					<h5 class="text-muted">Query</h5>
					<div><code class="text-success-emphasis">SELECT r.Name, r.Price</code></div>
					<div><code class="text-success-emphasis">FROM Rams r</code></div>
					<div><code class="text-success-emphasis">WHERE r.Price > @@p0</code></div>
					<div><code class="text-success-emphasis">ORDER BY r.Price DESC</code></div>
					<div><code class="text-success-emphasis">LIMIT 10</code></div>
				</div>

				<div class="col-12 border border-success-subtle rounded-3 bg-dark p-3">
					<h5 class="text-muted">Parameters</h5>
					<code>@@p1 = 10</code>
				</div>
			</div>
		</div>
	</div>
</div>
<!--Architectural Pipeline-->
<div class="container-fluid mt-5">
	<div class="display-6 fw-bold text-center mb-1">
		HOW IT WORKS
	</div>

	<div class="text-muted text-center mb-4">
		From raw expressions to validated SQL and parameterized queries.
	</div>

	<div class="card bg-dark text-light p-4 rounded-3 shadow">
		<div class="fw-semibold fs-5 text-secondary text-uppercase mb-2">
			FROM INPUT TO EXECUTION
		</div>

		<div class="text-muted small mb-4">
			Each expression passes through a structured pipeline before SQL is generated.
		</div>

		<!-- Pipeline Grid -->
		<div class="overflow-auto d-flex flex-nowrap align-items-center gap-2 justify-content-between">

			<!-- Step 1 -->
			<div class="card bg-body-tertiary border-0 text-center p-2 flex-fill" style="min-width: 110px;">
				<span class="badge bg-primary text-wrap mb-1 fs-6">1</span>
				<div class="fw-bold small">User Expression</div>
			</div>

			<i class="bi bi-arrow-right text-muted fs-4"></i>

			<!-- Step 2 -->
			<div class="card bg-body-tertiary border-0 text-center p-2 flex-fill" style="min-width: 110px;">
				<span class="badge bg-secondary text-wrap mb-1 fs-6">2</span>
				<div class="fw-bold small">Tokenizer</div>
			</div>

			<i class="bi bi-arrow-right text-muted fs-4"></i>

			<!-- Step 3 -->
			<div class="card bg-body-tertiary border-0 text-center p-2 flex-fill" style="min-width: 110px;">
				<span class="badge bg-secondary text-wrap mb-1 fs-6">3</span>
				<div class="fw-bold small">Parser</div>
			</div>

			<i class="bi bi-arrow-right text-muted fs-4"></i>

			<!-- Step 4 -->
			<div class="card bg-body-tertiary border-0 text-center p-2 flex-fill" style="min-width: 110px;">
				<span class="badge bg-secondary text-wrap mb-1 fs-6">4</span>
				<div class="fw-bold small">AST</div>
			</div>

			<i class="bi bi-arrow-right text-muted fs-4"></i>

			<!-- Step 5 -->
			<div class="card bg-body-tertiary border-0 text-center p-2 flex-fill" style="min-width: 110px;">
				<span class="badge bg-secondary text-wrap mb-1 fs-6">5</span>
				<div class="fw-bold small">Type Analysis</div>
			</div>

			<i class="bi bi-arrow-right text-muted fs-4"></i>

			<!-- Step 6 -->
			<div class="card bg-body-tertiary border-0 text-center p-2 flex-fill" style="min-width: 110px;">
				<span class="badge bg-secondary text-wrap mb-1 fs-6">6</span>
				<div class="fw-bold small">Validation</div>
			</div>

			<i class="bi bi-arrow-right text-muted fs-4"></i>

			<!-- Step 7 -->
			<div class="card bg-body-tertiary border-0 text-center p-2 flex-fill" style="min-width: 110px;">
				<span class="badge bg-success text-wrap mb-1 fs-6">7</span>
				<div class="fw-bold small">Generated SQL</div>
			</div>

			<i class="bi bi-arrow-right text-muted fs-4"></i>

			<!-- Step 8 -->
			<div class="card bg-body-tertiary border-0 text-center p-2 flex-fill" style="min-width: 110px;">
				<span class="badge bg-success text-wrap mb-1 fs-6">8</span>
				<div class="fw-bold small">Dapper Params</div>
			</div>
		</div>
	</div>
</div>
<!--Built With Confidence-->
<div class="card bg-dark text-light p-4 rounded-3 shadow mt-5">
	<div class="d-flex justify-content-between align-items-center mb-4 border-bottom border-secondary pb-3">
		<div>
			<div class="display-6 fw-bold text-uppercase">Built With Confidence</div>
			<p class="text-secondary mb-0">Extensive test suite ensuring zero parser regressions.</p>
		</div>
		<!-- Direct link to Test Project -->
		<a href="https://github.com/YOUR_USERNAME/YOUR_REPO/tree/main/tests" target="_blank" class="btn btn-outline-light btn-sm d-flex align-items-center gap-2">
			<i class="bi bi-github"></i> View Test Suite
		</a>
	</div>

	<div class="row align-items-center g-4">
		<!-- Left Column: Test Metrics -->
		<div class="col-lg-5">

			<!-- Big Total Badge -->
			<div class="card bg-success bg-opacity-10 border-success p-3 mb-4 rounded-3 text-center">
				<div class="display-5 fw-bold text-success">753</div>
				<div class="text-success text-uppercase fw-semibold fs-7 tracking-wider">Passing Unit Tests</div>
			</div>

			<!-- Breakdown List -->
			<div class="list-group list-group-flush bg-transparent">
				<div class="list-group-item bg-transparent text-light border-secondary d-flex justify-content-between align-items-center px-0">
					<span><i class="bi bi-check-circle-fill text-success me-2"></i>Tokenizer</span>
					<span class="badge bg-secondary rounded-pill">93 tests</span>
				</div>
				<div class="list-group-item bg-transparent text-light border-secondary d-flex justify-content-between align-items-center px-0">
					<span><i class="bi bi-check-circle-fill text-success me-2"></i>Parser</span>
					<span class="badge bg-secondary rounded-pill">410 tests</span>
				</div>
				<div class="list-group-item bg-transparent text-light border-secondary d-flex justify-content-between align-items-center px-0">
					<span><i class="bi bi-check-circle-fill text-success me-2"></i>Semantic Analyzer</span>
					<span class="badge bg-secondary rounded-pill">165 tests</span>
				</div>
				<div class="list-group-item bg-transparent text-light border-secondary d-flex justify-content-between align-items-center px-0">
					<span><i class="bi bi-check-circle-fill text-success me-2"></i>Query Builder</span>
					<span class="badge bg-secondary rounded-pill">85 tests</span>
				</div>
			</div>
		</div>

		<!-- Right Column: Test Explorer Screenshot Frame -->
		<div class="col-lg-7">
			<div class="border border-secondary rounded-3 overflow-hidden shadow">
				<!-- Mock Window Header -->
				<div class="bg-body-tertiary px-3 py-2 border-bottom border-secondary d-flex align-items-center justify-content-between">
					<small class="text-secondary font-monospace"><i class="bi bi-shield-check text-success me-1"></i> Visual Studio Test Explorer</small>
					<div class="d-flex gap-1">
						<span class="badge bg-success-subtle text-success border border-success-subtle">100% Passed</span>
					</div>
				</div>
				<!-- Test Explorer Screenshot -->
				<img src="/images/test_result.png"
					 alt="Visual Studio Test Explorer showing 753 green passing tests"
					 class="img-fluid w-100 d-block"
					 style="max-height: 380px; object-fit: cover; object-position: top;">
			</div>
		</div>
	</div>
</div>
<!--Tech Stack-->
