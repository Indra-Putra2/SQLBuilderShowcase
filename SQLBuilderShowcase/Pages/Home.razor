			</div>
		</div>

	</div>

	<div class="text-center mt-4 pt-3 border-top border-secondary text-secondary small">
		SQL Query Builder • Open Source Documentation Landing Page
	</div>
</footer>
<!--Details-->

@code {
	private bool isOpen = false;

	private void ToggleDropdown() => isOpen = !isOpen;
	private void CloseDropdown() => isOpen = false;

	private string _videoSource = "demo-success-base.mp4";
	private string _videoType = "Success";

	private void HandleVideo(string source, string type)
	{
		_videoSource = source;
		_videoType = type;
		CloseDropdown();
	}
}

