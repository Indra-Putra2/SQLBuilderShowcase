@page "/tokenizer"
@using SQLQueryBuilder.Core.Tokenizer
@using SQLQueryBuilder.Helper
@using SQLQueryBuilder.Model.Context
@inject HttpClient Http

<PageTitle>Tokenizer Visualizer</PageTitle>
<div class="container">
	<h1 class="fw-bold">
		Tokenizer Visualizer
	</h1>
	<hr />
	<p class="text-muted">
		The tokenizer converts raw SQL expressions into a sequence of tokens
		that can be consumed by the parser. Each token contains its type,
		position, and length, allowing the parser to understand the structure
		of the expression.
	</p>

	<div class="card">
		<div class="p-3 card-header">
			<label class="form-label fw-bold fs-5 mb-0" for="TokenInput">
				SQL Expression Input
			</label>
		</div>
		<div class="card-body">
			<div class="row">
				<div class="col-md-12">
					<textarea id="TokenInput"
							  class="form-control"
							  rows="5"
							  placeholder="e.g. price > 100 AND name LIKE 'RAM'"
							  @bind="_input">
			</textarea>
				</div>
			</div>
		</div>
		<div class="card-footer">
			<div class="row p-3">
				<div class="col-md-2">
					<button class="btn btn-outline-success fw-bold"
							@onclick="Tokenize">
						Tokenize
					</button>
				</div>
				<div class="d-flex col-sm gap-3 justify-content-end">
					<p class="text-muted my-auto">Presets</p>
					<button class="btn btn-outline-info fw-bold"
							@onclick="() => LoadInput(1)">
						Load Simple
					</button>
					<button class="btn btn-outline-info fw-bold"
							@onclick="() => LoadInput(2)">
						Load Complex
					</button>
				</div>
			</div>
		</div>

		@if (_error != null)
		{
			<div class="p-3">
				<div class="alert alert-danger">
					<pre>
					@_error
				</pre>
				</div>
			</div>
		}

		@if (!string.IsNullOrWhiteSpace(_originalText))
		{
			<div class="row p-3">
				<div class="col-md-12">
					<h5 class="fw-bold">
						Tokens:
					</h5>

					<table class="table table-striped table-hover">
						<thead>
							<tr>
								<th>#</th>
								<th>Type</th>
								<th>Value</th>
								<th>Start Position</th>
								<th>Length</th>
							</tr>
						</thead>

						<tbody>
							@foreach (var (token, index) in _tokens.Select((x, i) => (x, i)))
							{
								<tr>
									<td>@index</td>
									<td>@token.Type</td>
									<td>@GetSlice(token).ToString()</td>
									<td>@token.StartPosition</td>
									<td>@token.Length</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</div>
		}
	</div>
</div>



@code {
	private string _input = "name = \"Corsair\"";
	private string? _error;
	private string _originalText = string.Empty;
	private IReadOnlyList<SQLToken> _tokens;

	private void Tokenize()
	{
		SQLParserContext context = new();
		try
		{
			context = SQLBuilderHelper.BuildTokens(_input);
			_tokens = context.Tokens;
			_originalText = context.Span.ToString();
			_error = null;
		}
		catch (Exception ex)
		{
			context = new();
			_originalText = string.Empty;
			_error = ex.Message;
		}
	}

	private void LoadInput(int input)
	{
		_input = input switch
		{
			1 => "name = \"Corsair\"",
			2 => "name = \"Corsair\" and price between 10 and 100 and ReviewCount > 100",
			_ => "name = \"Corsair\""
		};

		_originalText = string.Empty;
	}

	private string GetSlice(SQLToken token)
	{
		return _originalText.Substring(token.StartPosition, token.Length);
	}
}