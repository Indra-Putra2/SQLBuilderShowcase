@page "/ast"
<PageTitle>AST Visualizer</PageTitle>
<div class="container d-flex flex-column gap-3">

    <div>
        <h1 class="fw-bold mb-1">AST Visualizer</h1>
        <hr />
        <p class="text-muted fs-5 mb-0">
            Parse SQL and explore its Abstract Syntax Tree.
        </p>
    </div>
    <div class="card shadow-sm">
        <div class="card-header bg-body-tertiary">
            <label class="form-label fw-bold fs-5 mb-0" for="sqlInput">
                SQL Expression Input
            </label>
        </div>

        <div class="card-body">
            <textarea class="form-control"
                      id="sqlInput"
                      rows="4"
                      @bind="_input"></textarea>
        </div>

        <div class="card-footer bg-body-tertiary d-flex flex-wrap gap-2 justify-content-between">
            <button type="button"
                    class="btn btn-primary fw-bold"
                    @onclick="CreateAST">
                <i class="bi bi-diagram-3 me-2"></i>
                Create AST
            </button>

            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="text-muted fw-bold">
                    Presets
                </span>

                <button type="button"
                        class="btn btn-outline-primary"
                        @onclick="() => LoadExpr(1)">
                    Simple Expression
                </button>

                <button type="button"
                        class="btn btn-outline-primary"
                        @onclick="() => LoadExpr(2)">
                    Complex Expression
                </button>
            </div>
        </div>
    </div>

    <div class="overflow-auto">
        <div class="card d-flex flex-column shadow-sm"
             style="width: max-content; min-width: 100%;">

            <div class="card-header d-flex align-items-center gap-2 text-muted fw-bold fs-4">
                <i class="bi bi-diagram-3"></i>
                SQL Expression AST
            </div>

            <div class="card-body p-3">
                @((MarkupString)_sb.ToString())
            </div>

        </div>
    </div>

</div>
